DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 模型调用（一般不用改）
LLM_TIMEOUT=180       # 单次调用超时（秒）
LLM_MAX_TOKENS=6000   # 单次输出上限；文件被截断就往上调
LLM_RETRIES=1         # 超时 / 429 / 5xx 重试次数

# 联网搜索（可选）。不填就关掉 search 动作。
#   serper  2500 次免费，之后 $1/千次
#   bocha   国内直连，约 ¥5/千次（以官网为准）
SEARCH_PROVIDER=
SEARCH_API_KEY=
